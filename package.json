{
  "name": "phrasepatch",
  "version": "0.2.0",
  "description": "Learn any language organically while prompting AI coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "phrasepatch": "./scripts/install.js"
  },
  "files": [
    "dist",
    "scripts",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build",
    "install:agents": "node scripts/install.js",
    "uninstall:agents": "node scripts/install.js --uninstall"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhellipePalitot/phrasepatch.git"
  },
  "bugs": {
    "url": "https://github.com/PhellipePalitot/phrasepatch/issues"
  },
  "homepage": "https://github.com/PhellipePalitot/phrasepatch#readme",
  "keywords": [
    "opencode",
    "openrouter",
    "language-learning",
    "ai-agents",
    "developer-tools",
    "language-coach",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
